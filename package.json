{
  "name": "stitchbook",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @stitchbook/db generate",
    "db:migrate": "pnpm --filter @stitchbook/db migrate",
    "db:studio": "pnpm --filter @stitchbook/db studio",
    "db:seed": "pnpm --filter @stitchbook/db seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "turbo": "^2.10.7",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "@types/node": "^26.1.2"
  }
}
